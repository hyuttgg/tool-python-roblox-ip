#!/usr/bin/env bash
# ==============================================================================
# ROBLOX MULTI-INSTANCE NETWORK CONTROLLER - ONE-CLICK FAST AUTO-INSTALLER
# ==============================================================================
# GitHub Repository: https://github.com/hyuttgg/tool-python-roblox-ip
# ==============================================================================

# ANSI Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
BOLD='\033[1m'
NC='\033[0m'

clear
echo -e "${CYAN}======================================================================${NC}"
echo -e "${GREEN}    ⚡ ROBLOX MULTI-TAG NETWORK CONTROLLER - FAST INSTALLER ⚡       ${NC}"
echo -e "${CYAN}    GitHub: https://github.com/hyuttgg/tool-python-roblox-ip           ${NC}"
echo -e "${CYAN}======================================================================${NC}"
echo ""

# 1. Cấp quyền bộ nhớ & Safe Git Config
echo -e "${YELLOW}[1/4] [*] Dang thiet lap quyen bo nho (Storage Setup)...${NC}"
cd "$HOME" 2>/dev/null || cd
if [ -e "$HOME/storage" ] || [ -e "/data/data/com.termux/files/home/storage" ]; then
    rm -rf "$HOME/storage" /data/data/com.termux/files/home/storage 2>/dev/null || true
fi

if command -v termux-setup-storage >/dev/null 2>&1; then
    termux-setup-storage 2>/dev/null || true
    sleep 1
fi

# Cấu hình Git an toàn để tránh lỗi dubious ownership trên Android
git config --global --add safe.directory "*" 2>/dev/null || true
git config --global core.filemode false 2>/dev/null || true

# 2. Cập nhật hệ thống & Cài đặt gói cần thiết
echo -e "${YELLOW}[2/4] [*] Dang cap nhat he thong & cai dat Python, Git, SQLite, Pip...${NC}"
if command -v pkg >/dev/null 2>&1; then
    yes | pkg update -o Dpkg::Options::="--force-confold" 2>/dev/null || true
    yes | pkg upgrade -y -o Dpkg::Options::="--force-confold" 2>/dev/null || true
    yes | pkg install -y openssl libcurl curl git python python-pip sqlite iproute2 dnsutils wget tsu openjdk-17 2>/dev/null || true
elif command -v apt-get >/dev/null 2>&1; then
    apt-get update -y 2>/dev/null || true
    apt-get install -y git python3 python3-pip sqlite3 iproute2 dnsutils curl wget 2>/dev/null || true
fi

# Cài đặt các thư viện Python chuyên dụng
pip install requests psutil rich prettytable pytz 2>/dev/null || python -m pip install requests psutil rich prettytable pytz 2>/dev/null || true

# 3. Cài đặt Core Tool trên Termux ($HOME) & Thiết lập Runner tại thư mục Downloads
echo -e "${YELLOW}[3/4] [*] Dang cai dat Core Tool tren Termux va tao Runner tai Downloads...${NC}"

CORE_DIR="$HOME/tool-python-roblox-ip"
mkdir -p "$CORE_DIR" 2>/dev/null || true

# Cập nhật nếu đã có Core, hoặc tải mới
if [ -d "$CORE_DIR/.git" ]; then
    echo -e "${CYAN}[*] Dang cap nhat ma nguon moi nhat tai $CORE_DIR...${NC}"
    cd "$CORE_DIR" 2>/dev/null || true
    git fetch origin main 2>/dev/null || true
    git reset --hard origin/main 2>/dev/null || git pull origin main --force 2>/dev/null || true
else
    echo -e "${CYAN}[*] Dang clone / tai ma nguon vao Termux ($CORE_DIR)...${NC}"
    rm -rf "$CORE_DIR" 2>/dev/null || true
    mkdir -p "$CORE_DIR" 2>/dev/null || true

    # 1. Git clone vào Termux Home
    git clone -c core.fileMode=false https://github.com/hyuttgg/tool-python-roblox-ip.git "$CORE_DIR" 2>/dev/null || true

    # 2. Dự phòng qua Python / Curl nếu git clone bị lỗi
    if [ ! -f "$CORE_DIR/controller.py" ]; then
        echo -e "${YELLOW}[*] Dang dong bo qua Python Engine (Bypass SSL/Curl)...${NC}"
        curl -sL https://github.com/hyuttgg/tool-python-roblox-ip/archive/refs/heads/main.tar.gz | tar -xz -C "$CORE_DIR" --strip-components=1 2>/dev/null || true
    fi
fi

cd "$CORE_DIR" 2>/dev/null || true

# Cài đặt requirements.txt
if [ -f "$CORE_DIR/requirements.txt" ]; then
    pip install -r "$CORE_DIR/requirements.txt" 2>/dev/null || true
fi

# Biên dịch Native C++ Hardware Probe nếu có clang
mkdir -p "$CORE_DIR/data/native_bin"
if command -v clang++ >/dev/null 2>&1 && [ -f "$CORE_DIR/core/native_hardware_probe.cpp" ]; then
    clang++ -O3 -shared -fPIC -o "$CORE_DIR/data/native_bin/libhardware_probe.so" "$CORE_DIR/core/native_hardware_probe.cpp" 2>/dev/null || true
fi

# Thiết lập Workspace và Script chạy tại thư mục Downloads trên điện thoại
DOWNLOAD_DIR="/sdcard/Download/RobloxIPTool"
mkdir -p "/sdcard/Download" 2>/dev/null || true
mkdir -p "$DOWNLOAD_DIR" 2>/dev/null || true
mkdir -p "$DOWNLOAD_DIR/data" 2>/dev/null || true
mkdir -p "$DOWNLOAD_DIR/data/generated_lua" 2>/dev/null || true

# Đồng bộ file Lua và config ra Downloads
if [ -d "$CORE_DIR/data" ]; then
    cp -rn "$CORE_DIR/data"/* "$DOWNLOAD_DIR/data/" 2>/dev/null || true
fi

# Tạo Script chạy trong thư mục Downloads
cat << 'EOF' > "$DOWNLOAD_DIR/run.sh"
#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# SCRIPT CHẠY TOOL ROBLOX IP TỪ THƯ MỤC DOWNLOADS
# ==============================================================================
CORE_DIR="$HOME/tool-python-roblox-ip"
if [ ! -d "$CORE_DIR" ]; then
    CORE_DIR="/data/data/com.termux/files/home/tool-python-roblox-ip"
fi

if [ -f "$CORE_DIR/controller.py" ]; then
    cd "$CORE_DIR" && bash run.sh "$@"
elif [ -f "$CORE_DIR/pyobfuscate_com.py" ]; then
    cd "$CORE_DIR" && bash run.sh "$@"
else
    echo "[-] Khong tim thay ma nguon tool tai: $CORE_DIR"
fi
EOF

chmod +x "$DOWNLOAD_DIR/run.sh" 2>/dev/null || true
cp "$DOWNLOAD_DIR/run.sh" "$DOWNLOAD_DIR/start.sh" 2>/dev/null || true
chmod +x "$DOWNLOAD_DIR/start.sh" 2>/dev/null || true

# Tạo Hướng dẫn trong Downloads
cat << 'EOF' > "$DOWNLOAD_DIR/HUONG_DAN_CHAY.txt"
================================================================================
  HƯỚNG DẪN CHẠY TOOL PYTHON ROBLOX IP TỪ THƯ MỤC DOWNLOADS TRÊN ĐIỆN THOẠI
================================================================================

1. CÁCH CHẠY TOOL:
   - Cách 1 (Nhanh nhất): Mở Termux, gõ:
       roblox-ip

   - Cách 2: Mở Termux, vào thư mục Downloads rồi chạy:
       cd /sdcard/Download/RobloxIPTool
       bash run.sh

2. THƯ MỤC SCRIPT LUA XUẤT RA:
   - data/generated_lua/ : Chứa toàn bộ file Lua cho từng Tag
                          (ROBLOX-TAG-01.lua, master_roblox_ip_setter.lua...)
                          Dùng File Manager / ZArchiver copy vào Executor dễ dàng!
================================================================================
EOF

# 4. Cấp quyền thực thi và tạo phím tắt lệnh toàn cầu roblox-ip
echo -e "${YELLOW}[4/4] [*] Dang cap quyen thuc thi & tao lenh tat roblox-ip...${NC}"
chmod +x "$CORE_DIR"/*.py 2>/dev/null || true
chmod +x "$CORE_DIR"/*.sh 2>/dev/null || true
chmod +x "$CORE_DIR"/shell/*.sh 2>/dev/null || true

if [ -d "/data/data/com.termux/files/usr/bin" ]; then
    cat << 'EOF' > /data/data/com.termux/files/usr/bin/roblox-ip
#!/data/data/com.termux/files/usr/bin/bash
CORE_DIR="$HOME/tool-python-roblox-ip"
if [ ! -d "$CORE_DIR" ]; then
    CORE_DIR="/data/data/com.termux/files/home/tool-python-roblox-ip"
fi

if [ -f "$CORE_DIR/controller.py" ]; then
    cd "$CORE_DIR" && bash run.sh "$@"
elif [ -f "$CORE_DIR/pyobfuscate_com.py" ]; then
    cd "$CORE_DIR" && bash run.sh "$@"
else
    echo "[-] Khong tim thay ma nguon tai: $CORE_DIR"
fi
EOF
    chmod +x /data/data/com.termux/files/usr/bin/roblox-ip 2>/dev/null || true
fi

echo ""
echo -e "${GREEN}======================================================================${NC}"
echo -e "${GREEN}[+] CÀI ĐẶT THÀNH CÔNG TOOL PYTHON ROBLOX IP!                         ${NC}"
echo -e "${CYAN}• Phần Cài Đặt (Core): ${WHITE}$CORE_DIR (Termux)${NC}"
echo -e "${CYAN}• Phần Chạy & Script:  ${GREEN}$DOWNLOAD_DIR (Downloads)${NC}"
echo -e "${GREEN}======================================================================${NC}"
echo ""
echo -e "${WHITE}${BOLD}📌 CÁCH CHẠY TOOL TRÊN ĐIỆN THOẠI:${NC}"
echo -e "${CYAN}👉 Cách 1 (Khuyên dùng):${NC} Mở Termux gõ lệnh ${GREEN}${BOLD}roblox-ip${NC}"
echo -e "${CYAN}👉 Cách 2:${NC} Gõ ${YELLOW}cd /sdcard/Download/RobloxIPTool && bash run.sh${NC}"
echo -e "${GREEN}======================================================================${NC}"
