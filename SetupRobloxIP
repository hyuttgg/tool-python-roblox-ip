#!/usr/bin/env bash
# ==============================================================================
# ROBLOX MULTI-INSTANCE NETWORK CONTROLLER - ONE-CLICK CURL INSTALLER
# ==============================================================================

set -e

# ANSI Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

clear
echo -e "${CYAN}======================================================================${NC}"
echo -e "${GREEN}    ⚡ ROBLOX MULTI-TAG NETWORK CONTROLLER - FAST INSTALLER ⚡       ${NC}"
echo -e "${CYAN}======================================================================${NC}"
echo ""

# 1. Kiểm tra môi trường Termux / Linux
echo -e "${YELLOW}[1/4] [*] Dang kiem tra va cap nhat moi truong he thong...${NC}"
if command -v pkg >/dev/null 2>&1; then
    pkg update -y -o Dpkg::Options::="--force-confold" 2>/dev/null || true
    apt --fix-broken install -y 2>/dev/null || true
    pkg install -y openssl libcurl git python python-pip openjdk-17 sqlite curl iproute2 dnsutils tsu || true
elif command -v apt-get >/dev/null 2>&1; then
    apt-get update -y 2>/dev/null || true
    apt-get install -y git python3 python3-pip openjdk-17-jre sqlite3 curl || true
fi

# 2. Cài đặt các thư viện Python
echo -e "${YELLOW}[2/4] [*] Dang cai dat cac thu vien Python...${NC}"
pip install --upgrade pip requests psutil 2>/dev/null || pip3 install requests psutil 2>/dev/null || true

# 3. Tải hoặc cập nhật mã nguồn từ GitHub
echo -e "${YELLOW}[3/4] [*] Dang dong bo ma nguon tu GitHub (hyuttgg/tool-python-roblox-ip)...${NC}"

# Tự động yêu cầu quyền bộ nhớ nếu Termux chưa có
if command -v termux-setup-storage >/dev/null 2>&1; then
    if [ ! -d "/sdcard/Download" ] && [ ! -d "$HOME/storage/downloads" ]; then
        echo -e "${YELLOW}[!] Dang yeu cau quyen bo nho (termux-setup-storage)...${NC}"
        termux-setup-storage || true
        sleep 1
    fi
fi

# Ưu tiên lưu vào thư mục Download của điện thoại
if [ -d "/sdcard/Download" ]; then
    TARGET_DIR="/sdcard/Download/tool-python-roblox-ip"
elif [ -d "/storage/emulated/0/Download" ]; then
    TARGET_DIR="/storage/emulated/0/Download/tool-python-roblox-ip"
elif [ -d "$HOME/storage/downloads" ]; then
    TARGET_DIR="$HOME/storage/downloads/tool-python-roblox-ip"
else
    mkdir -p "/sdcard/Download" 2>/dev/null || true
    if [ -d "/sdcard/Download" ]; then
        TARGET_DIR="/sdcard/Download/tool-python-roblox-ip"
    else
        TARGET_DIR="$HOME/tool-python-roblox-ip"
    fi
fi

if [ -d "$TARGET_DIR" ]; then
    echo -e "${CYAN}[*] Thu muc da ton tai tai $TARGET_DIR, dang cap nhat ma nguon moi nhat...${NC}"
    cd "$TARGET_DIR"
    git pull origin main 2>/dev/null || true
else
    echo -e "${CYAN}[*] Dang clone ma nguon vao $TARGET_DIR...${NC}"
    git clone https://github.com/hyuttgg/tool-python-roblox-ip.git "$TARGET_DIR"
    cd "$TARGET_DIR"
fi

# 4. Cấp quyền thực thi
echo -e "${YELLOW}[4/4] [*] Dang cap quyen thuc thi cho cac script...${NC}"
chmod +x shell/*.sh 2>/dev/null || true
chmod +x *.py 2>/dev/null || true

echo ""
echo -e "${GREEN}======================================================================${NC}"
echo -e "${GREEN}[+] CAI DAT MOI TRUONG & TAI TOOL THANH CONG!                         ${NC}"
echo -e "${CYAN}👉 Hay chay lenh o Buoc 3 de mo Tool voi quyen Root (SU).            ${NC}"
echo -e "${GREEN}======================================================================${NC}"
