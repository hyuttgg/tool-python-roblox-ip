#!/usr/bin/env bash
# ==============================================================================
# ROBLOX MULTI-INSTANCE NETWORK CONTROLLER - ONE-CLICK FAST AUTO-INSTALLER
# ==============================================================================
# GitHub Repository: https://github.com/hyuttgg/tool-python-roblox-ip
# ==============================================================================

# ANSI Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
BOLD='\033[1m'
NC='\033[0m'

clear
echo -e "${CYAN}======================================================================${NC}"
echo -e "${GREEN}    ⚡ ROBLOX MULTI-TAG NETWORK CONTROLLER - FAST INSTALLER ⚡       ${NC}"
echo -e "${CYAN}    GitHub: https://github.com/hyuttgg/tool-python-roblox-ip           ${NC}"
echo -e "${CYAN}======================================================================${NC}"
echo ""

# 1. Cấp quyền bộ nhớ & Safe Git Config
echo -e "${YELLOW}[1/4] [*] Dang thiet lap quyen bo nho (Storage Setup)...${NC}"
cd "$HOME" 2>/dev/null || cd
if [ -e "$HOME/storage" ] || [ -e "/data/data/com.termux/files/home/storage" ]; then
    rm -rf "$HOME/storage" /data/data/com.termux/files/home/storage 2>/dev/null || true
fi

if command -v termux-setup-storage >/dev/null 2>&1; then
    termux-setup-storage 2>/dev/null || true
    sleep 1
fi

# Cấu hình Git an toàn để tránh lỗi dubious ownership trên Android
git config --global --add safe.directory "*" 2>/dev/null || true
git config --global core.filemode false 2>/dev/null || true

# 2. Cập nhật hệ thống & Cài đặt gói cần thiết
echo -e "${YELLOW}[2/4] [*] Dang cap nhat he thong & cai dat Python, Git, SQLite, Pip...${NC}"
if command -v pkg >/dev/null 2>&1; then
    yes | pkg update -o Dpkg::Options::="--force-confold" 2>/dev/null || true
    yes | pkg upgrade -y -o Dpkg::Options::="--force-confold" 2>/dev/null || true
    yes | pkg install -y openssl libcurl curl git python python-pip sqlite iproute2 dnsutils wget tsu openjdk-17 2>/dev/null || true
elif command -v apt-get >/dev/null 2>&1; then
    apt-get update -y 2>/dev/null || true
    apt-get install -y git python3 python3-pip sqlite3 iproute2 dnsutils curl wget 2>/dev/null || true
fi

# Cài đặt các thư viện Python chuyên dụng
pip install requests psutil rich prettytable pytz 2>/dev/null || python -m pip install requests psutil rich prettytable pytz 2>/dev/null || true

# 3. Tải tool trực tiếp vào thư mục Download / Tệp tải về của máy
echo -e "${YELLOW}[3/4] [*] Dang cai dat tool truc tiep vao thu muc Download cua may...${NC}"

# Tạo thư mục Download nếu chưa có
mkdir -p "/sdcard/Download" 2>/dev/null || mkdir -p "/storage/emulated/0/Download" 2>/dev/null || true

if [ -d "/sdcard/Download" ]; then
    TARGET_DIR="/sdcard/Download/tool-python-roblox-ip"
elif [ -d "/storage/emulated/0/Download" ]; then
    TARGET_DIR="/storage/emulated/0/Download/tool-python-roblox-ip"
elif [ -d "$HOME/storage/downloads" ]; then
    TARGET_DIR="$HOME/storage/downloads/tool-python-roblox-ip"
else
    TARGET_DIR="/sdcard/Download/tool-python-roblox-ip"
    mkdir -p "$TARGET_DIR" 2>/dev/null || true
fi

# Cập nhật nếu đã có thư mục, hoặc tải mới
if [ -d "$TARGET_DIR" ]; then
    echo -e "${CYAN}[*] Dang cap nhat ma nguon moi nhat tai $TARGET_DIR...${NC}"
    cd "$TARGET_DIR" 2>/dev/null || true
    git fetch origin main 2>/dev/null || true
    git reset --hard origin/main 2>/dev/null || git pull origin main --force 2>/dev/null || true
    # Đồng bộ trực tiếp gói tar mới nhất để tránh lỗi file cũ bị giữ lại trên Android
    curl -sL https://github.com/hyuttgg/tool-python-roblox-ip/archive/refs/heads/main.tar.gz | tar -xz -C "$TARGET_DIR" --strip-components=1 2>/dev/null || true
fi

# Nếu chưa có thư mục, clone / tải mới
if [ ! -f "$TARGET_DIR/pyobfuscate_com.py" ] && [ ! -f "$TARGET_DIR/controller.py" ]; then
    echo -e "${CYAN}[*] Dang clone / tai ma nguon truc tiep vao $TARGET_DIR...${NC}"
    rm -rf "$TARGET_DIR" 2>/dev/null || true
    mkdir -p "$TARGET_DIR" 2>/dev/null || true

    # 1. Thử git clone
    git clone -c core.fileMode=false https://github.com/hyuttgg/tool-python-roblox-ip.git "$TARGET_DIR" 2>/dev/null || true

    # 2. Nếu git clone lỗi do libcurl mismatch, dùng Python Engine độc lập tải trực tiếp
    if [ ! -f "$TARGET_DIR/pyobfuscate_com.py" ] && [ ! -f "$TARGET_DIR/controller.py" ]; then
        echo -e "${YELLOW}[*] Dang dong bo qua Python Engine (Bypass SSL/Curl)...${NC}"
        python -c "
import urllib.request, tarfile, io, os
url = 'https://github.com/hyuttgg/tool-python-roblox-ip/archive/refs/heads/main.tar.gz'
try:
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    with urllib.request.urlopen(req, timeout=20) as resp:
        tar_bytes = resp.read()
    with tarfile.open(fileobj=io.BytesIO(tar_bytes), mode='r:gz') as tar:
        for member in tar.getmembers():
            parts = member.name.split('/', 1)
            if len(parts) > 1 and parts[1]:
                member.name = parts[1]
                tar.extract(member, path='$TARGET_DIR')
    print('[+] Dong bo ma nguon thanh cong!')
except Exception as e:
    print('[-] Error:', e)
" 2>/dev/null || true
    fi

    # 3. Thử curl / wget dự phòng
    if [ ! -f "$TARGET_DIR/pyobfuscate_com.py" ] && [ ! -f "$TARGET_DIR/controller.py" ]; then
        curl -sL https://github.com/hyuttgg/tool-python-roblox-ip/archive/refs/heads/main.tar.gz | tar -xz -C "$TARGET_DIR" --strip-components=1 2>/dev/null || true
    fi
fi

cd "$TARGET_DIR" 2>/dev/null || true

# Cài đặt requirements.txt nếu có
if [ -f "$TARGET_DIR/requirements.txt" ]; then
    pip install -r "$TARGET_DIR/requirements.txt" 2>/dev/null || true
fi

# 4. Cấp quyền thực thi và tạo phím tắt lệnh
echo -e "${YELLOW}[4/4] [*] Dang cap quyen thuc thi & tao lenh tat roblox-ip...${NC}"
chmod +x "$TARGET_DIR"/*.py 2>/dev/null || true
chmod +x "$TARGET_DIR"/*.sh 2>/dev/null || true
chmod +x "$TARGET_DIR"/shell/*.sh 2>/dev/null || true

if [ -d "/data/data/com.termux/files/usr/bin" ]; then
    cat << 'EOF' > /data/data/com.termux/files/usr/bin/roblox-ip
#!/data/data/com.termux/files/usr/bin/bash
TARGET_DIR=""
candidates=(
    "/sdcard/Download/tool-python-roblox-ip"
    "/storage/emulated/0/Download/tool-python-roblox-ip"
    "$HOME/tool-python-roblox-ip"
    "/data/data/com.termux/files/home/tool-python-roblox-ip"
)
for dir in "${candidates[@]}"; do
    if [ -f "${dir}/pyobfuscate_com.py" ] || [ -f "${dir}/controller.py" ]; then
        TARGET_DIR="${dir}"
        break
    fi
done

if [ -n "$TARGET_DIR" ]; then
    cd "$TARGET_DIR" && bash run.sh "$@"
else
    echo "[-] Khong tim thay thu muc tool-python-roblox-ip!"
fi
EOF
    chmod +x /data/data/com.termux/files/usr/bin/roblox-ip 2>/dev/null || true
fi

echo ""
echo -e "${GREEN}======================================================================${NC}"
echo -e "${GREEN}[+] CAI DAT THANH CONG VAO TEP TAI VE (DOWNLOADS)!                   ${NC}"
echo -e "${CYAN}👉 Vi tri tool: ${TARGET_DIR}                                         ${NC}"
echo -e "${GREEN}======================================================================${NC}"
echo ""
echo -e "${WHITE}${BOLD}📌 3 BƯỚC CÀI ĐẶT & CHẠY TOOL CHUẨN:${NC}"
echo ""
echo -e "${CYAN}1️⃣  Thay đổi repository Termux (neu chua thuc hien):${NC}"
echo -e "${WHITE}    termux-change-repo${NC}"
echo -e "${YELLOW}    📌 Nhan OK -> OK${NC}"
echo ""
echo -e "${CYAN}2️⃣  Lenh cai dat tool:${NC}"
echo -e "${WHITE}    . <(curl -sL https://raw.githubusercontent.com/hyuttgg/tool-python-roblox-ip/refs/heads/main/SetupRobloxIP)${NC}"
echo ""
echo -e "${CYAN}3️⃣  Lenh chay tool (Quyen Root / SU):${NC}"
echo -e "${GREEN}    su -c \"export PATH=\$PATH:/data/data/com.termux/files/usr/bin && export TERM=xterm-256color && cd /sdcard/Download/tool-python-roblox-ip && python pyobfuscate_com.py\"${NC}"
echo ""
echo -e "${YELLOW}👉 Hoac chay truc tiep bang lenh tat: ${GREEN}roblox-ip${NC}"
echo -e "${GREEN}======================================================================${NC}"
