#!/usr/bin/env bash
# ==============================================================================
# ROBLOX MULTI-INSTANCE NETWORK CONTROLLER - ONE-CLICK CURL INSTALLER
# ==============================================================================

set -e

# ANSI Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

clear
echo -e "${CYAN}======================================================================${NC}"
echo -e "${GREEN}    ⚡ ROBLOX MULTI-TAG NETWORK CONTROLLER - FAST INSTALLER ⚡       ${NC}"
echo -e "${CYAN}======================================================================${NC}"
echo ""

# 1. Kiểm tra môi trường Termux / Linux
echo -e "${YELLOW}[1/4] [*] Dang kiem tra va cap nhat moi truong he thong...${NC}"
if command -v pkg >/dev/null 2>&1; then
    pkg update -y -o Dpkg::Options::="--force-confold" || true
    pkg install -y git python python-pip openjdk-17 sqlite curl iproute2 dnsutils tsu || true
elif command -v apt-get >/dev/null 2>&1; then
    apt-get update -y || true
    apt-get install -y git python3 python3-pip openjdk-17-jre sqlite3 curl || true
fi

# 2. Cài đặt các thư viện Python
echo -e "${YELLOW}[2/4] [*] Dang cai dat cac thu vien Python...${NC}"
pip install --upgrade pip requests psutil 2>/dev/null || pip3 install requests psutil 2>/dev/null || true

# 3. Tải hoặc cập nhật mã nguồn từ GitHub
echo -e "${YELLOW}[3/4] [*] Dang dong bo ma nguon tu GitHub (hyuttgg/tool-python-roblox-ip)...${NC}"
TARGET_DIR="tool-python-roblox-ip"

if [ -d "$TARGET_DIR" ]; then
    echo -e "${CYAN}[*] Thu muc da ton tai, dang cap nhat ma nguon moi nhat...${NC}"
    cd "$TARGET_DIR"
    git pull origin main 2>/dev/null || true
else
    git clone https://github.com/hyuttgg/tool-python-roblox-ip.git "$TARGET_DIR"
    cd "$TARGET_DIR"
fi

# 4. Cấp quyền và Khởi chạy Master Controller
echo -e "${YELLOW}[4/4] [*] Dang cap quyen va khoi dong Master Controller...${NC}"
chmod +x shell/*.sh 2>/dev/null || true
chmod +x *.py 2>/dev/null || true

echo ""
echo -e "${GREEN}======================================================================${NC}"
echo -e "${GREEN}[+] CAI DAT THANH CONG! DANG VAO MENU MASTER CONTROLLER...            ${NC}"
echo -e "${GREEN}======================================================================${NC}"
sleep 1

if command -v python >/dev/null 2>&1; then
    python controller.py
elif command -v python3 >/dev/null 2>&1; then
    python3 controller.py
fi
