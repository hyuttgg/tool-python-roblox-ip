#!/usr/bin/env bash
# ==============================================================================
# ROBLOX MULTI-INSTANCE NETWORK CONTROLLER - ONE-CLICK FAST AUTO-INSTALLER
# ==============================================================================

# ANSI Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

clear
echo -e "${CYAN}======================================================================${NC}"
echo -e "${GREEN}    ⚡ ROBLOX MULTI-TAG NETWORK CONTROLLER - FAST INSTALLER ⚡       ${NC}"
echo -e "${CYAN}======================================================================${NC}"
echo ""

# 1. Tự động Reset & Cấp quyền bộ nhớ (Storage Setup)
echo -e "${YELLOW}[1/4] [*] Dang thiet lap quyen bo nho (Storage Setup)...${NC}"
cd "$HOME" 2>/dev/null || cd
if [ -e "$HOME/storage" ] || [ -e "/data/data/com.termux/files/home/storage" ]; then
    rm -rf "$HOME/storage" /data/data/com.termux/files/home/storage 2>/dev/null || true
fi

if command -v termux-setup-storage >/dev/null 2>&1; then
    termux-setup-storage 2>/dev/null || true
    sleep 1
fi

# Cấu hình Git an toàn để tránh lỗi dubious ownership trên Android
git config --global --add safe.directory "*" 2>/dev/null || true
git config --global core.filemode false 2>/dev/null || true

# 2. Tự động Cập nhật & Cài đặt hệ thống (Auto-Confirm YES)
echo -e "${YELLOW}[2/4] [*] Dang cap nhat he thong & cai dat Python, Git, SQLite, Pip...${NC}"
if command -v pkg >/dev/null 2>&1; then
    yes | pkg update -o Dpkg::Options::="--force-confold" 2>/dev/null || true
    yes | pkg i git python python-pip sqlite curl wget tsu 2>/dev/null || pkg install -y git python python-pip sqlite curl wget tsu 2>/dev/null || true
elif command -v apt-get >/dev/null 2>&1; then
    apt-get update -y 2>/dev/null || true
    apt-get install -y git python3 python3-pip sqlite3 curl wget 2>/dev/null || true
fi

# Cài đặt các thư viện Python chuyên dụng
pip install requests psutil rich prettytable pytz 2>/dev/null || python -m pip install requests psutil rich prettytable pytz 2>/dev/null || true

# 3. Tải tool trực tiếp vào thư mục Download / Tệp tải về của máy
echo -e "${YELLOW}[3/4] [*] Dang cai dat tool truc tiep vao thu muc Download cua may...${NC}"

# Tạo thư mục Download nếu chưa có
mkdir -p "/sdcard/Download" 2>/dev/null || mkdir -p "/storage/emulated/0/Download" 2>/dev/null || true

if [ -d "/sdcard/Download" ]; then
    TARGET_DIR="/sdcard/Download/tool-python-roblox-ip"
elif [ -d "/storage/emulated/0/Download" ]; then
    TARGET_DIR="/storage/emulated/0/Download/tool-python-roblox-ip"
elif [ -d "$HOME/storage/downloads" ]; then
    TARGET_DIR="$HOME/storage/downloads/tool-python-roblox-ip"
else
    TARGET_DIR="/sdcard/Download/tool-python-roblox-ip"
    mkdir -p "$TARGET_DIR" 2>/dev/null || true
fi

if [ -d "$TARGET_DIR/.git" ]; then
    echo -e "${CYAN}[*] Thu muc da ton tai tai $TARGET_DIR, dang cap nhat ma nguon moi nhat...${NC}"
    cd "$TARGET_DIR"
    git fetch origin main 2>/dev/null || true
    git reset --hard origin/main 2>/dev/null || git pull origin main 2>/dev/null || true
else
    echo -e "${CYAN}[*] Dang clone ma nguon truc tiep vao $TARGET_DIR...${NC}"
    rm -rf "$TARGET_DIR" 2>/dev/null || true
    git clone -c core.fileMode=false https://github.com/hyuttgg/tool-python-roblox-ip.git "$TARGET_DIR" 2>/dev/null || {
        echo -e "${YELLOW}[*] Dang thu lai voi archive stream...${NC}"
        mkdir -p "$TARGET_DIR" 2>/dev/null || true
        curl -sL https://github.com/hyuttgg/tool-python-roblox-ip/archive/refs/heads/main.tar.gz | tar -xz -C "$TARGET_DIR" --strip-components=1 2>/dev/null || true
    }
    cd "$TARGET_DIR" 2>/dev/null || true
fi

# 4. Cấp quyền thực thi
echo -e "${YELLOW}[4/4] [*] Dang cap quyen thuc thi cho cac script...${NC}"
chmod +x shell/*.sh 2>/dev/null || true
chmod +x *.py 2>/dev/null || true

echo ""
echo -e "${GREEN}======================================================================${NC}"
echo -e "${GREEN}[+] CAI DAT THANH CONG VAO TEP TAI VE (DOWNLOADS)!                   ${NC}"
echo -e "${CYAN}👉 Vi tri tool: ${TARGET_DIR}                                         ${NC}"
echo -e "${GREEN}======================================================================${NC}"
echo -e "${YELLOW}👉 Chay 1 trong 2 lenh sau de mo Tool:                                ${NC}"
echo -e "${GREEN}1. Chay truc tiep:                                                   ${NC}"
echo -e "${CYAN}cd ${TARGET_DIR} && python controller.py                             ${NC}"
echo -e "${GREEN}2. Hoac chay voi quyen Root (SU):                                    ${NC}"
echo -e "${CYAN}su -c \"cd ${TARGET_DIR} && /data/data/com.termux/files/usr/bin/python controller.py\"${NC}"
echo -e "${GREEN}======================================================================${NC}"
