# ==============================================================================
# ROBLOX MULTI-TAG NETWORK CONTROLLER & TERMUX TOOLKIT CONFIGURATION
# ==============================================================================
export TOOLKIT_NAME="Termux Roblox Multi-Tag Controller"
export TOOLKIT_VERSION="2.5.0"
export REPO_OWNER="hyuttgg"
export REPO_NAME="tool-python-roblox-ip"
export REPO_BRANCH="main"
export GITHUB_REPO_URL="https://github.com/${REPO_OWNER}/${REPO_NAME}.git"
export GITHUB_RAW_URL="https://raw.githubusercontent.com/${REPO_OWNER}/${REPO_NAME}/${REPO_BRANCH}"

# Network Defaults
export HTTP_BRIDGE_HOST="127.0.0.1"
export HTTP_BRIDGE_PORT="8888"
export TPROXY_PORT="10808"
export DNS_PORT="53"
export DEFAULT_DNS_UPSTREAM="1.1.1.1"
export DEFAULT_PLACE_ID="2753915549"
export DEFAULT_COUNTRY="MULTI"

# Paths
export TOOLKIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TOOLKIT_DATA="${TOOLKIT_DIR}/data"
export TOOLKIT_LOGS="${TOOLKIT_DIR}/logs"
export TOOLKIT_CONFIG="${TOOLKIT_DIR}/config"
export TOOLKIT_TOOLS="${TOOLKIT_DIR}/tools"
export TOOLKIT_LIB="${TOOLKIT_DIR}/lib"
export TOOLKIT_CORE="${TOOLKIT_DIR}/core"
export TOOLKIT_BIN="${TOOLKIT_DIR}/bin"
