#!/data/data/com.termux/files/usr/bin/bash
# ====================================================================================
# ⚡ ROBLOX MULTI-INSTANCE & AUTO-REJOIN ONE-CLICK FAST INSTALLER ⚡
# Tự động: Sửa Repo Termux -> Cài Packages -> Cài Python Pip -> Đồng bộ /sdcard/Download
# ====================================================================================

# Bảng mã màu ANSI
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_CYAN="\033[1;36m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_PURPLE="\033[1;35m"
C_GRAY="\033[0;90m"

clear 2>/dev/null || printf "\033c"
echo -e "${C_PURPLE}╔════════════════════════════════════════════════════════════════════════════╗${C_RESET}"
echo -e "${C_PURPLE}║${C_RESET}  ${C_BOLD}${C_CYAN}⚡ [ ROBLOX AUTO-REJOIN & NETWORK CONTROLLER INSTALLER ] ⚡${C_RESET}           ${C_PURPLE}║${C_RESET}"
echo -e "${C_PURPLE}║${C_RESET}  ${C_GRAY}GitHub:${C_RESET} ${C_YELLOW}https://github.com/hyuttgg/tool-python-roblox-ip${C_RESET}                     ${C_PURPLE}║${C_RESET}"
echo -e "${C_PURPLE}║${C_RESET}  ${C_GRAY}Vị trí cài đặt:${C_RESET} ${C_GREEN}/sdcard/Download/tool-python-roblox-ip-main${C_RESET}               ${C_PURPLE}║${C_RESET}"
echo -e "${C_PURPLE}╚════════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"

# 1. Cấp quyền truy cập bộ nhớ lưu trữ (/sdcard)
echo -e "  ${C_CYAN}[1/5] Thiết lập quyền truy cập bộ nhớ Android (/sdcard)...${C_RESET}"
if [ ! -d "$HOME/storage/shared" ]; then
    echo -e "  ${C_YELLOW}➔ Vui lòng chọn [ CHO PHÉP / ALLOW ] khi có thông báo quyền bộ nhớ!${C_RESET}"
    termux-setup-storage 2>/dev/null || true
    sleep 2
fi

# Tự động vá .sqliterc để xuất raw text
if [ -f "$HOME/.sqliterc" ]; then
    sed -i 's/\.mode box/\.mode list/g' "$HOME/.sqliterc" 2>/dev/null || true
    sed -i 's/\.headers on/\.headers off/g' "$HOME/.sqliterc" 2>/dev/null || true
fi

# 2. Tự động khắc phục Repository Termux (Tránh lỗi 403 / 404 / Lock)
echo -e "\n  ${C_CYAN}[2/5] Đang kiểm tra & tối ưu Repository Termux (Grimler Mirror)...${C_RESET}"
rm -f /data/data/com.termux/files/usr/var/lib/dpkg/lock* 2>/dev/null || true
rm -f /data/data/com.termux/files/usr/var/lib/apt/lists/lock* 2>/dev/null || true
export DEBIAN_FRONTEND=noninteractive

if [ -d "/data/data/com.termux/files/usr/etc/apt" ]; then
    sed -i 's@^\(deb.*games\)$@#\1@' /data/data/com.termux/files/usr/etc/apt/sources.list.d/game.list 2>/dev/null || true
    sed -i 's@^\(deb.*science\)$@#\1@' /data/data/com.termux/files/usr/etc/apt/sources.list.d/science.list 2>/dev/null || true
    echo "deb https://grimler.se/termux/termux-main stable main" > /data/data/com.termux/files/usr/etc/apt/sources.list 2>/dev/null || true
fi

pkg update -y 2>/dev/null || apt-get update -y 2>/dev/null || apt update -y 2>/dev/null || true

# 3. Cài đặt các gói hệ thống & thư viện Python
echo -e "\n  ${C_CYAN}[3/5] Đang cài đặt Python, Git, Pip, TSU, JQ, Procps và thư viện...${C_RESET}"
pkg install -y python python-pip git curl jq tsu proot procps sqlite iproute2 dnsutils wget 2>/dev/null || \
apt-get install -y python python3-pip git curl jq sqlite3 iproute2 2>/dev/null || true

# Cấu hình Git tránh lỗi Ownership
git config --global --add safe.directory "*" 2>/dev/null || true
git config --global core.filemode false 2>/dev/null || true

# Cài đặt thư viện Python cần thiết
python -m pip install --upgrade pip --no-warn-script-location 2>/dev/null || true
python -m pip install requests psutil urllib3 rich prettytable pytz --no-warn-script-location 2>/dev/null || \
pip install requests psutil urllib3 rich prettytable pytz 2>/dev/null || true

# 4. Tải & Đồng bộ mã nguồn về thư mục /sdcard/Download
echo -e "\n  ${C_CYAN}[4/5] Đang đồng bộ mã nguồn vào /sdcard/Download...${C_RESET}"
DOWNLOAD_DIR="/sdcard/Download"
TARGET_DIR="${DOWNLOAD_DIR}/tool-python-roblox-ip-main"
mkdir -p "${DOWNLOAD_DIR}" 2>/dev/null || true
mkdir -p "${TARGET_DIR}" 2>/dev/null || true

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
if [ -f "${SCRIPT_DIR}/controller.py" ]; then
    cp -rf "${SCRIPT_DIR}/"* "${TARGET_DIR}/" 2>/dev/null || true
elif [ -f "$HOME/tool-python-roblox-ip/controller.py" ]; then
    cp -rf "$HOME/tool-python-roblox-ip/"* "${TARGET_DIR}/" 2>/dev/null || true
else
    git clone --depth=1 https://github.com/hyuttgg/tool-python-roblox-ip.git "${TARGET_DIR}" 2>/dev/null || true
    if [ ! -f "${TARGET_DIR}/controller.py" ]; then
        curl -sL https://github.com/hyuttgg/tool-python-roblox-ip/archive/refs/heads/main.tar.gz | tar -xz -C "${TARGET_DIR}" --strip-components=1 2>/dev/null || true
    fi
fi

# Đồng bộ file chạy chính launcher.py trực tiếp tại /sdcard/Download
if [ -f "${TARGET_DIR}/launcher.py" ]; then
    cp -rf "${TARGET_DIR}/launcher.py" "${DOWNLOAD_DIR}/launcher.py" 2>/dev/null || true
fi
if [ -f "${TARGET_DIR}/zamtoolrejoinnewtool.py" ]; then
    cp -rf "${TARGET_DIR}/zamtoolrejoinnewtool.py" "${DOWNLOAD_DIR}/zamtoolrejoinnewtool.py" 2>/dev/null || true
fi

# Tự động tạo thư mục Autoexec / Execute cho tất cả Executor phổ biến
for exec_dir in "/sdcard/Delta/Autoexec" "/sdcard/Delta/execute" "/sdcard/Delta/scripts" \
                "/sdcard/Arceus X/Autoexec" "/sdcard/Arceus X/execute" "/sdcard/Arceus X/scripts" \
                "/sdcard/Codex/Autoexec" "/sdcard/Codex/execute" "/sdcard/Codex/scripts" \
                "/sdcard/Fluxus/Autoexec" "/sdcard/Fluxus/execute" \
                "/sdcard/VegaX/Autoexec" "/sdcard/VegaX/execute" \
                "/sdcard/Hydrogen/Autoexec"; do
    mkdir -p "${exec_dir}" 2>/dev/null || true
done

# Tạo shortcut lệnh nhanh 'rejoin', 'roblox-rejoin', 'roblox-ip', 'run' trong Termux
for CMD_NAME in "rejoin" "roblox-rejoin" "roblox-ip" "run"; do
    CMD_PATH="/data/data/com.termux/files/usr/bin/${CMD_NAME}"
    cat << 'EOF' > "$CMD_PATH"
#!/data/data/com.termux/files/usr/bin/bash
if command -v su >/dev/null 2>&1; then
    su -c "export PATH=\$PATH:/data/data/com.termux/files/usr/bin && export TERM=xterm-256color && cd /sdcard/Download && python launcher.py" 2>/dev/null || \
    (export PATH="$PATH:/data/data/com.termux/files/usr/bin" && export TERM=xterm-256color && cd /sdcard/Download && python launcher.py)
else
    export PATH="$PATH:/data/data/com.termux/files/usr/bin"
    export TERM=xterm-256color
    cd /sdcard/Download && python launcher.py
fi
EOF
    chmod +x "$CMD_PATH" 2>/dev/null || true
done

# 5. Hoàn tất & Tự động chạy tool
echo -e "\n  ${C_GREEN}${C_BOLD}[5/5] ✓ CÀI ĐẶT HOÀN TẤT 100%!${C_RESET}\n"
echo -e "${C_PURPLE}════════════════════════════════════════════════════════════════════════════${C_RESET}"
echo -e "  ${C_BOLD}${C_YELLOW}🚀 CÂU LỆNH CHẠY TOOL GỐC (ROOT):${C_RESET}"
echo -e "  ${C_GREEN}su -c \"export PATH=\$PATH:/data/data/com.termux/files/usr/bin && export TERM=xterm-256color && cd /sdcard/Download && python launcher.py\"${C_RESET}"
echo -e ""
echo -e "  ${C_BOLD}${C_YELLOW}⚡ HOẶC GÕ PHÍM TẮT NHANH BẤT KỲ ĐÂU:${C_RESET}"
echo -e "  ${C_GREEN}rejoin${C_RESET}   hoặc   ${C_GREEN}run${C_RESET}"
echo -e "${C_PURPLE}════════════════════════════════════════════════════════════════════════════${C_RESET}\n"

# Khởi chạy ngay bằng đúng câu lệnh launcher.py
if command -v su >/dev/null 2>&1; then
    su -c "export PATH=\$PATH:/data/data/com.termux/files/usr/bin && export TERM=xterm-256color && cd /sdcard/Download && python launcher.py" 2>/dev/null || \
    (export PATH="$PATH:/data/data/com.termux/files/usr/bin" && export TERM=xterm-256color && cd /sdcard/Download && python launcher.py)
else
    export PATH="$PATH:/data/data/com.termux/files/usr/bin"
    export TERM=xterm-256color
    cd /sdcard/Download && python launcher.py
fi
