#!/data/data/com.termux/files/usr/bin/bash
# ====================================================================================
# ⚡ SETUBTOOLREJOIN: BỘ CÀI ĐẶT TRỌN GÓI 1-CHẠM CHO TERMUX ANDROID ⚡
# Tự động cập nhật gói, cài thư viện Python và tải bộ não controller.py vào /sdcard/Download
# ====================================================================================

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_CYAN="\033[1;36m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"

clear 2>/dev/null || printf "\033c"
echo -e "${C_CYAN}╔════════════════════════════════════════════════════════════════════════════╗${C_RESET}"
echo -e "${C_CYAN}║${C_RESET}  ${C_BOLD}${C_GREEN}⚡ [ ROBLOX REJOIN & SET IP AUTO-INSTALLER ] ⚡${C_RESET}                           ${C_CYAN}║${C_RESET}"
echo -e "${C_CYAN}║${C_RESET}  ${C_YELLOW}Tự động cài đặt gói Termux & tải bộ não controller.py về /sdcard/Download${C_RESET}  ${C_CYAN}║${C_RESET}"
echo -e "${C_CYAN}╚════════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"

# 1. Cấp quyền truy cập bộ nhớ lưu trữ
echo -e "  ${C_CYAN}[1/3] Đang cấp quyền bộ nhớ lưu trữ (/sdcard)...${C_RESET}"
termux-setup-storage 2>/dev/null || true

# 2. Cài đặt các gói hệ thống và thư viện Python
echo -e "\n  ${C_CYAN}[2/3] Đang cài đặt Python, Git, Pip, TSU, JQ, Procps và thư viện...${C_RESET}"
pkg update -y 2>/dev/null || apt update -y 2>/dev/null || true
pkg install -y python python-pip git curl jq tsu proot procps sqlite iproute2 2>/dev/null || apt install -y python python3-pip git curl jq
python -m pip install --upgrade pip --no-warn-script-location 2>/dev/null || true
python -m pip install requests psutil urllib3 rich prettytable pytz --no-warn-script-location 2>/dev/null || pip install requests psutil urllib3 rich prettytable pytz 2>/dev/null || true

# 3. Tải và đồng bộ mã nguồn về /sdcard/Download
echo -e "\n  ${C_CYAN}[3/3] Đang đồng bộ bộ não controller.py vào /sdcard/Download...${C_RESET}"
TARGET_DIR="/sdcard/Download/tool-python-roblox-ip-main"
mkdir -p "$TARGET_DIR" 2>/dev/null || true

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
if [ -f "${SCRIPT_DIR}/controller.py" ]; then
    cp -rf "${SCRIPT_DIR}/"* "$TARGET_DIR/" 2>/dev/null || true
    cp -rf "${SCRIPT_DIR}/zamtoolrejoinnewtool.py" "/sdcard/Download/" 2>/dev/null || true
else
    git clone --depth=1 https://github.com/hyuttgg/tool-python-roblox-ip.git "$TARGET_DIR" 2>/dev/null || true
    cp -rf "$TARGET_DIR/zamtoolrejoinnewtool.py" "/sdcard/Download/" 2>/dev/null || true
fi

# Tạo thư mục execute/autoexec cho executor
for exec_dir in "/sdcard/Delta/Autoexec" "/sdcard/Delta/execute" \
                "/sdcard/Arceus X/Autoexec" "/sdcard/Arceus X/execute" \
                "/sdcard/Codex/Autoexec" "/sdcard/Codex/execute" \
                "/sdcard/Fluxus/Autoexec" "/sdcard/VegaX/Autoexec"; do
    mkdir -p "$exec_dir" 2>/dev/null || true
done

echo -e "\n  ${C_GREEN}${C_BOLD}✓ CÀI ĐẶT HOÀN TẤT THÀNH CÔNG!${C_RESET}\n"
echo -e "  ${C_YELLOW}➤ Chạy lệnh sau để mở tool:${C_RESET}"
echo -e "  ${C_GREEN}cd /sdcard/Download/tool-python-roblox-ip-main && python controller.py${C_RESET}\n"
